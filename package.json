{
  "name": "ai-mysql",
  "version": "0.1.3",
  "fxVersion": "2.14.3",
  "private": true,
  "description": "Database engine and oxmysql stand-in: provides oxmysql, mysql-async and ghmattimysql",
  "license": "GPL-3.0-only",
  "author": {
    "name": "TGIANN"
  },
  "repository": "github:aifivem/ai-mysql",
  "type": "module",
  "fxDependencies": [
    "/server:12913"
  ],
  "scripts": {
    "lint": "oxlint --ignore-pattern \"dist/**\"",
    "format": "prettier --write .",
    "dev": "bun tsdown -- --watch",
    "build": "bun tsdown -- && aicore-client-errors dist/client.js",
    "typecheck": "tsc --noEmit -p resource/server/tsconfig.json"
  },
  "dependencies": {
    "@aicore-fivem/lib": "workspace:*",
    "@aicore-fivem/mysql": "workspace:*"
  },
  "devDependencies": {
    "@aicore-fivem/build": "workspace:*",
    "@citizenfx/client": "latest",
    "@citizenfx/server": "latest",
    "@types/bun": "latest",
    "@types/node": "^22",
    "fast-glob": "^3.3.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "oxlint": "^1.66.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "fxProvide": [
    "oxmysql",
    "mysql-async",
    "ghmattimysql"
  ]
}
